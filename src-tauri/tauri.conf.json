{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "loch.js",
  "version": "0.1.0",
  "identifier": "sk.speleo.lochjs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "loch.js",
        "width": 1100,
        "height": 720,
        "minWidth": 420,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "3D cave model viewer"
  }
}
